# Copy to .env and change the passwords. Never commit .env.

# PostgreSQL
POSTGRES_DB=coldchain
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=change-me

# InfluxDB (password: at least 8 characters)
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-please
INFLUXDB_ORG=haccp
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=change-me-long-random-token

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me

# Simulators: seconds between readings
SENSOR_INTERVAL=5
